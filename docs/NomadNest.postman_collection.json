{
  "info": {
    "name": "NomadNest API",
    "description": "Colección completa de la API NomadNest para testing y desarrollo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3010",
      "type": "default"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "default"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "default"
    },
    {
      "key": "userId",
      "value": "",
      "type": "default"
    },
    {
      "key": "alojamientoId",
      "value": "",
      "type": "default"
    },
    {
      "key": "categoriaId",
      "value": "",
      "type": "default"
    },
    {
      "key": "comentarioId",
      "value": "",
      "type": "default"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh token si está próximo a expirar"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Status 200', function() {",
          "    pm.response.to.have.status(200);",
          "});",
          "",
          "// Guardar tokens después de login",
          "if (pm.request.url.path.includes('login') && pm.response.json().success) {",
          "    var jsonData = pm.response.json();",
          "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
          "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
          "    pm.collectionVariables.set('userId', jsonData.user.id);",
          "}",
          "",
          "// Guardar IDs creados",
          "if (pm.request.url.path.includes('alojamientos') && pm.request.method === 'POST') {",
          "    var jsonData = pm.response.json();",
          "    if (jsonData.id) pm.collectionVariables.set('alojamientoId', jsonData.id);",
          "}",
          "",
          "if (pm.request.url.path.includes('categorias') && pm.request.method === 'POST') {",
          "    var jsonData = pm.response.json();",
          "    if (jsonData.id) pm.collectionVariables.set('categoriaId', jsonData.id);",
          "}",
          "",
          "if (pm.request.url.path.includes('comentarios') && pm.request.method === 'POST') {",
          "    var jsonData = pm.response.json();",
          "    if (jsonData.id) pm.collectionVariables.set('comentarioId', jsonData.id);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Token de acceso recibido', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.accessToken).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test('Refresh token recibido', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.refreshToken).to.not.be.undefined;",
                  "});",
                  "",
                  "// Guardar tokens",
                  "if (pm.response.json().success) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh exitoso', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Nuevo access token', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.accessToken).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout exitoso', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "// Limpiar tokens",
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('refreshToken', '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (Get Current User)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuario autenticado', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Datos de usuario presentes', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.user).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
