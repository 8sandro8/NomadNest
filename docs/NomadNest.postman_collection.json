    {
      "name": "Tests",
      "item": [
        {
          "name": "Test Flujo Completo",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test: Login y flujo completo",
                  "console.log('=== Test: Flujo Completo ===');",
                  "",
                  "pm.test('1. Login exitoso', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('2. Access token recibido', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.accessToken).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test('3. Refresh token recibido', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.refreshToken).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test('4. Usuario es admin', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.user.role).to.equal('admin');",
                  "});",
                  "",
                  "// Guardar tokens para siguiente request",
                  "if (pm.response.json().success) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "    console.log('Tokens guardados para siguientes requests');",
                  "}",
                  "",
                  "console.log('=== Fin Test: Flujo Completo ===');"
                ]
              }
            }
          ]
        },
        {
          "name": "Test Autenticación Error",
          "request": {
            "method": "POST",
